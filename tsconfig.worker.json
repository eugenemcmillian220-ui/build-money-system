{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "noEmit": false,
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/worker/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src/app/**/*",
    "src/lib/stripe.ts"
  ]
}
