# ============================================================
# Sovereign Forge OS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Variables are classified as:
#   [PUBLIC]  — safe to expose in browser (NEXT_PUBLIC_ prefix)
#   [SERVER]  — server-only, never in client bundle
#   [SECRET]  — high-sensitivity, rotation required
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co           # [PUBLIC]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                         # [PUBLIC]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                     # [SECRET] rotate every 180 days
SUPABASE_ACCESS_TOKEN=sbp_placeholder                               # [SECRET]
SUPABASE_MANAGEMENT_API_KEY=sbp_placeholder                         # [SECRET]

# ── Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app                    # [PUBLIC]

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_placeholder                               # [SECRET] rotate every 90 days
STRIPE_WEBHOOK_SECRET=whsec_placeholder                             # [SECRET]
STRIPE_ACCOUNT_ID=acct_placeholder                                  # [SERVER]
STRIPE_BASIC_STARTER_MONTHLY_PRICE_ID=price_placeholder             # [SERVER]
STRIPE_BASIC_STARTER_YEARLY_PRICE_ID=price_placeholder              # [SERVER]
STRIPE_BASIC_PRO_MONTHLY_PRICE_ID=price_placeholder                 # [SERVER]
STRIPE_BASIC_PRO_YEARLY_PRICE_ID=price_placeholder                  # [SERVER]
STRIPE_ELITE_ENTERPRISE_MONTHLY_PRICE_ID=price_placeholder          # [SERVER]
STRIPE_CREDITS_10K_PRICE_ID=price_placeholder                       # [SERVER]
STRIPE_CREDITS_25K_PRICE_ID=price_placeholder                       # [SERVER]
STRIPE_CREDITS_50K_PRICE_ID=price_placeholder                       # [SERVER]

# ── Railway Pipeline ──────────────────────────────────────────
RAILWAY_PIPELINE_URL=https://your-railway-service.railway.app       # [SERVER]
RAILWAY_SECRET=your-shared-secret-here                              # [SECRET]
RAILWAY_API_TOKEN=placeholder                                       # [SECRET]
RAILWAY_PUBLIC_DOMAIN=your-railway-service.railway.app             # [SERVER]

# ── AI Providers ──────────────────────────────────────────────
GITHUB_TOKEN=ghp_placeholder                                        # [SECRET] rotate every 90 days
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com       # [SERVER]
OPENCODE_GO_API_KEY=sk-go-placeholder                               # [SECRET]
OPENCODE_GO_API_KEYS=sk-go-key1,sk-go-key2                         # [SECRET]
OPENCODE_ZEN_API_KEY=sk-zen-placeholder                             # [SECRET]
OPENCODE_ZEN_API_KEYS=sk-zen-key1,sk-zen-key2                      # [SECRET]
HF_TOKEN=hf_placeholder                                             # [SECRET]

# ── Upstash Redis (optional — enables pipeline output caching)
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io               # [SERVER]
UPSTASH_REDIS_REST_TOKEN=placeholder                                # [SECRET]

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_placeholder                                       # [SECRET]
RESEND_FROM_EMAIL=noreply@your-domain.com                          # [SERVER]

# ── Slack Notifications ───────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/placeholder      # [SECRET]
SLACK_BOT_TOKEN=xoxb-placeholder                                   # [SECRET]
SLACK_CHANNEL_ID=C_placeholder                                     # [SERVER]

# ── Monitoring & Analytics ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@sentry.io/1             # [PUBLIC]
SENTRY_AUTH_TOKEN=placeholder                                      # [SECRET]
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder                            # [PUBLIC]
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com                   # [PUBLIC]

# ── Vercel ────────────────────────────────────────────────────
VERCEL_ACCESS_TOKEN=placeholder                                    # [SECRET]
VERCEL_PROJECT_ID=prj_placeholder                                  # [SERVER]
VERCEL_TEAM_ID=team_placeholder                                    # [SERVER]

# ── GitHub ────────────────────────────────────────────────────
GITHUB_ACCESS_TOKEN=ghp_placeholder                                # [SECRET]
GITHUB_USERNAME=your-username                                      # [SERVER]
GITHUB_REPO=your-repo                                              # [SERVER]
GITHUB_DEFAULT_BRANCH=main                                         # [SERVER]

# ── Worker / Pipeline Internal ────────────────────────────────
WORKER_SHARED_SECRET=your-worker-secret-here                       # [SECRET]
WORKER_BASE_URL=https://your-worker.railway.app                    # [SERVER]
CRON_SECRET=your-cron-secret-here                                  # [SECRET]

# ── Arize AI / OpenTelemetry (optional) ───────────────────────
ARIZE_API_KEY=ak-placeholder                                       # [SECRET]
ARIZE_SPACE_ID=placeholder                                         # [SERVER]
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.arize.com/v1             # [SERVER]
OTEL_EXPORTER_OTLP_HEADERS=space_id=placeholder,Authorization=ak-placeholder # [SECRET]

# ── Admin ─────────────────────────────────────────────────────
ADMIN_API_KEYS=key1,key2                                           # [SECRET]
