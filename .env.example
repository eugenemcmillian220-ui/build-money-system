# ============================================================
# Sovereign Forge OS — Environment Variables
# Copy this file to .env.local for local development.
# Set all variables in Vercel + Railway dashboards for production.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API

# Public URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Public anon key (safe to expose to browser — RLS enforces security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose to browser or commit to git
# Used for: admin operations, credit deductions, org creation
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Railway (Pipeline Worker) ────────────────────────────────
# Found in: Railway Dashboard → Service → Variables

# Full URL of your Railway pipeline worker service
# Format: https://YOUR-SERVICE.up.railway.app
RAILWAY_BACKEND_URL=https://your-pipeline-worker.up.railway.app

# Shared secret for authenticating Vercel → Railway requests
# Generate with: openssl rand -hex 32
# Must match WORKER_SHARED_SECRET on the Railway service
RAILWAY_INTERNAL_SECRET=your-secret-here

# ─── Vercel ───────────────────────────────────────────────────
# Set automatically by Vercel — do NOT set manually in production

# The canonical public URL of your app (set this manually)
NEXT_PUBLIC_SITE_URL=https://build-money-system-omd8.vercel.app

# These are injected by Vercel automatically at build/runtime:
# VERCEL_URL         — deployment URL (no https:// prefix)
# VERCEL_BRANCH_URL  — branch deployment URL
# VERCEL_ENV         — "production" | "preview" | "development"

# ─── Stripe (Payments) ────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API Keys

# Secret key — server-side only, NEVER expose to browser
STRIPE_SECRET_KEY=sk_live_...

# Publishable key — safe to expose to browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret — from Stripe Dashboard → Webhooks
# Used to verify webhook payloads from Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── PostHog (Analytics) ──────────────────────────────────────
# Found in: PostHog Dashboard → Project → Settings → API Keys

NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry (Error Tracking) ──────────────────────────────────
# Found in: Sentry Dashboard → Project → Settings → SDK Setup

SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Sentry org + project (for source maps upload during build)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=sovereign-forge

# Auth token for Sentry CLI (source map uploads)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── AI / LLM (if calling from Vercel — otherwise Railway handles) ───
# Only needed if any Vercel API routes call LLMs directly

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── App Config ───────────────────────────────────────────────

# Node environment
NODE_ENV=production

# ─── Railway Worker Variables (set in Railway, not Vercel) ────
# These live on the Railway service, not in this file.
# Documented here for reference:
#
# WORKER_SHARED_SECRET   — Must match RAILWAY_INTERNAL_SECRET above
# NEXT_PUBLIC_SUPABASE_URL — Same as above
# SUPABASE_SERVICE_ROLE_KEY — Same as above
# OPENAI_API_KEY         — LLM key for pipeline agents
# ANTHROPIC_API_KEY      — Optional: Claude for specific agents
# PORT                   — Railway sets this automatically (default 3000)
