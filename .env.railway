# Railway pipeline server environment variables
# Copy these to your Railway service's Variables tab

# Server
PORT=3001

# Security — must match RAILWAY_INTERNAL_SECRET in Vercel env vars
RAILWAY_INTERNAL_SECRET=replace_with_strong_secret

# Supabase (same values as your Vercel deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS — set to your Vercel deployment URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Railway auto-injects these (do not set manually):
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_ENVIRONMENT
# RAILWAY_SERVICE_NAME
